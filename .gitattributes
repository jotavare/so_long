# Keep everything in the repository as LF, whatever the checkout platform.
* text=auto eol=lf

# Maps are program input, read byte by byte by the parser: keep them LF so a
# stray carriage return is never mistaken for a tile.
*.ber text eol=lf

# Textures are XPM, which is C source in form but must not be reflowed.
*.xpm -text
